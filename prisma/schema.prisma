generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Attendance {
  id             String   @id @default(uuid())
  studentName    String
  rollNumber     String
  attendanceDate DateTime
  status         String
  createdAt      DateTime @default(now())
}